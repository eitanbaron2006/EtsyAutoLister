# ---------------------------------------------------------------- Supabase --
# Local stack lives in this repo: `npx supabase start` (see supabase/config.toml).
# It uses port block 573xx so it does not collide with other local Supabase
# projects on this machine.
#   API     http://127.0.0.1:57321
#   Studio  http://127.0.0.1:57323
#   Mailpit http://127.0.0.1:57324
# `npx supabase start` prints the keys to paste below.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:57321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=""

# Direct Postgres connection (psql / scripts).
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:57322/postgres"

# Google sign-in. Register this redirect URI in the Google Cloud console:
#   http://127.0.0.1:57321/auth/v1/callback
# then set [auth.external.google].enabled = true in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""

# Google Drive, for listings whose files Etsy will not carry.
# Can reuse the sign-in OAuth client; register this redirect URI on it:
#   <APP_URL>/api/auth/drive/callback
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""

# Optional: when set, listing generation uses the Gemini API.
# When unset, listing generation falls back to Vertex AI through ADC.
GEMINI_API_KEY=""

# Vertex AI fallback for listing generation (server-side only).
VERTEX_PROJECT_ID="vertextai-project-497513"
VERTEX_LOCATION="global"
VERTEX_MODEL="gemini-3.1-pro-preview"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Etsy API Credentials
ETSY_API_KEY=""
ETSY_API_SECRET=""

# Etsy App Config
#
# You need an Etsy developer account and an app registered with them. In that
# app's settings, register this exact callback URL:
#
#     <APP_URL>/api/auth/etsy/callback
#
# Etsy refuses to redirect back to any address that is not registered, matched
# character for character. So <APP_URL> must be the value of APP_URL above --
# NOT whatever is in your browser's address bar. The server builds the
# redirect_uri from APP_URL (app/api/auth/etsy/url/route.ts), and falls back to
# http://localhost:3000 when it is unset. Browsing on http://127.0.0.1:3000
# while APP_URL says localhost is a redirect_uri mismatch, and Etsy reports it
# as an unhelpful generic error.
#
# Leave ETSY_API_KEY empty to run in demo mode: Connect stores a DEMO_TOKEN and
# publishing returns a fake listing id without ever calling Etsy. Everything
# except the shop's real name, logo and colour works offline that way.

# MockupGen render server (local mockup rendering, no auth).
# Can also be overridden per-browser from the workspace settings panel.
NEXT_PUBLIC_MOCKUPGEN_URL="http://127.0.0.1:5000"
