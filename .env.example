# ---------------------------------------------------------------- Supabase --
# Local stack lives in this repo: `npx supabase start` (see supabase/config.toml).
# It uses port block 573xx so it does not collide with other local Supabase
# projects on this machine.
#   API     http://127.0.0.1:57321
#   Studio  http://127.0.0.1:57323
#   Mailpit http://127.0.0.1:57324
# `npx supabase start` prints the keys to paste below.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:57321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=""

# Direct Postgres connection (psql / scripts).
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:57322/postgres"

# Google sign-in. Register this redirect URI in the Google Cloud console:
#   http://127.0.0.1:57321/auth/v1/callback
# then set [auth.external.google].enabled = true in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""

# Optional: when set, listing generation uses the Gemini API.
# When unset, listing generation falls back to Vertex AI through ADC.
GEMINI_API_KEY=""

# Vertex AI fallback for listing generation (server-side only).
VERTEX_PROJECT_ID="vertextai-project-497513"
VERTEX_LOCATION="global"
VERTEX_MODEL="gemini-3.1-pro-preview"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Etsy API Credentials
ETSY_API_KEY=""
ETSY_API_SECRET=""

# Etsy App Config
# Need an Etsy dev account, create an app, add callback URL `<APP_URL>/auth/etsy`

# MockupGen render server (local mockup rendering, no auth).
# Can also be overridden per-browser from the workspace settings panel.
NEXT_PUBLIC_MOCKUPGEN_URL="http://127.0.0.1:5000"
